{
    "openapi": "3.0.0",
    "info": {
        "title": "Grades API",
        "description": "API Documentation for Student Grade and Curriculum Management",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Local API Server"
        }
    ],
    "paths": {
        "/api/v1/curriculums": {
            "get": {
                "tags": [
                    "Grades"
                ],
                "summary": "Daftar aturan prasyarat kurikulum",
                "operationId": "580dfd2db9d016e66014796821f3c4e9",
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                },
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ]
            }
        },
        "/api/v1/grades/initialize": {
            "post": {
                "tags": [
                    "Grades"
                ],
                "summary": "Initialize student grade record",
                "operationId": "2b140c1f9fc9c9faf361c3557769aa30",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "student_id": {
                                        "type": "string",
                                        "example": "102022400285"
                                    },
                                    "course_code": {
                                        "type": "string",
                                        "example": "SI4808"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Grade initialized and audited"
                    }
                },
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ]
            }
        },
        "/api/v1/grades/{id}": {
            "get": {
                "tags": [
                    "Grades"
                ],
                "summary": "Get grade details",
                "operationId": "d76ab5c30aaa9e9a01e042471dd3806a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Grade record found"
                    },
                    "404": {
                        "description": "Grade record not found"
                    }
                },
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "ApiKeyAuth": {
                "type": "apiKey",
                "name": "X-IAE-KEY",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Grades",
            "description": "Grades & Curriculum API"
        }
    ]
}